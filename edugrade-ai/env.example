# ---------- Models ----------
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_BACKEND=sentence-transformers     # sentence-transformers | hashing (offline fallback for tests/CI)
SENTIMENT_MODEL=cardiffnlp/twitter-roberta-base-sentiment-latest
SENTIMENT_BACKEND=transformers              # transformers | lexicon (offline fallback)
OCR_ENGINE=auto                             # auto | tesseract | easyocr
TESSERACT_CMD=                              # set if tesseract is not on PATH
# Use hashing offline to avoid downloading an embedding model.
# EMBEDDING_BACKEND=hashing
# Use lexicon offline to avoid downloading a sentiment model.
# SENTIMENT_BACKEND=lexicon

# ---------- Hybrid scoring weights (concept_confidence) ----------
W_SEMANTIC=0.70
W_KEYWORD=0.20
W_CONTEXT=0.10
MATCH_THRESHOLD=0.65
PARTIAL_THRESHOLD=0.45
AWARD_MIN_CONF=0.30
AWARD_MAX_CONF=0.80

# ---------- Grading mode ----------
FINAL_MODE=rubric                           # rubric | reference | blend
BLEND_RUBRIC_WEIGHT=0.6
REF_SIM_FLOOR=0.35
REF_SIM_CEIL=0.85

# ---------- Storage ----------
# DATABASE_URL=postgresql://user:pass@localhost/edugrade   (PostgreSQL swap-in)
# DATA_DIR=data
# UPLOAD_DIR=data/raw/uploads
# MODELS_DIR=models